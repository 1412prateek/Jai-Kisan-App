<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/app_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- 🔹 Top Banner / Illustration -->
        <ImageView
            android:id="@+id/diseaseBanner"
            android:layout_width="330dp"
            android:layout_height="200dp"
            android:layout_marginBottom="16dp"
            android:layout_marginTop="25dp"
            android:background="@drawable/card_bg_round"
            android:contentDescription="Detect Disease Banner"
            android:scaleType="centerCrop"
            android:src="@drawable/diseasebanner"

            app:cardPreventCornerOverlap="false"
            app:cardUseCompatPadding="true" />



        

        <!-- 🔹 Subtitle -->
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Upload or capture a leaf image to detect plant disease.\nपौधे की पत्ती की छवि अपलोड करें या कैप्चर करें।"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <!-- 🔹 Image Preview Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardImagePreview"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@android:color/white">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Placeholder Image -->
                <ImageView
                    android:id="@+id/imagePreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:src="@android:drawable/ic_menu_report_image"
                    android:contentDescription="Selected Image"/>

                <!-- Overlay Text for Placeholder -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/placeholderText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="No Image Selected\nकोई छवि चयनित नहीं"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="@android:color/darker_gray"/>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 🔹 Buttons: Capture & Upload -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCaptureImage"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Capture Photo\nफोटो लें"
                app:icon="@android:drawable/ic_menu_camera"
                app:iconGravity="textStart"
                android:layout_marginEnd="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUploadImage"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Upload Image\nछवि अपलोड करें"
                app:icon="@android:drawable/ic_menu_gallery"
                app:iconGravity="textStart"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- 🔹 Detect Disease Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetectDisease"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Detect Disease\nबीमारी पहचानें"
            app:icon="@android:drawable/ic_menu_search"
            app:iconGravity="textStart"
            android:layout_marginBottom="20dp"/>

        <!-- 🔹 Result Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvDiseaseName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Disease: "
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="@color/green"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvDiseaseInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Disease details and preventive measures will appear here.\nबीमारी का विवरण और निवारक उपाय यहां दिखाई देंगे।"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:layout_marginBottom="8dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
