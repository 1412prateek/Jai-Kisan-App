<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_background"
    android:fitsSystemWindows="true"
    tools:context=".DetectDiseaseActivity">

    <!-- The stylish, floating toolbar with the new theme -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="25dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="#FFCC80">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:title="Photo Expert / फोटो विशेषज्ञ"
                app:titleTextColor="@color/text_on_sandy_brown"
                app:navigationIconTint="@color/text_on_sandy_brown" />

        </com.google.android.material.card.MaterialCardView>

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="16dp">

            <!-- ✅ IMPROVEMENT: The description text is now inside its own elevated card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="#EAEAEA"
                app:cardPreventCornerOverlap="false"
                app:cardBackgroundColor="@android:color/white">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvDetectDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="16dp"
                    android:text="Analyze any crop, leaf, or fruit. Capture or upload a photo for an expert report.\nकिसी भी फसल, पत्ती या फल का विश्लेषण करें। विशेषज्ञ रिपोर्ट पाने के लिए फोटो खींचें या अपलोड करें।"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
            </com.google.android.material.card.MaterialCardView>


            <!-- Card background changed to white -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardImagePreview"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@android:color/white">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/imagePreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="Selected Image"/>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/placeholderText"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="No Image Selected\nकोई छवि चयनित नहीं"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@color/theme_reseda_green"/>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCaptureImage"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Capture\nफोटो लें"
                    app:icon="@drawable/ic_modern_camera"
                    app:iconGravity="textStart"
                    app:backgroundTint="@color/theme_wheat"
                    android:textColor="@color/text_on_sandy_brown"
                    app:iconTint="@color/text_on_sandy_brown"
                    android:layout_marginEnd="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUploadImage"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Upload\nअपलोड करें"
                    app:icon="@drawable/ic_modern_gallery"
                    app:iconGravity="textStart"
                    app:backgroundTint="@color/theme_wheat"
                    android:textColor="@color/text_on_sandy_brown"
                    app:iconTint="@color/text_on_sandy_brown"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetectDisease"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Analyze Photo\nफोटो का विश्लेषण करें"
                app:icon="@drawable/ic_modern_search"
                app:backgroundTint="@color/theme_reseda_green"
                app:iconGravity="textStart"
                android:layout_marginBottom="20dp"/>

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/loadingIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true"
                app:indicatorColor="@color/theme_reseda_green"
                android:visibility="gone"
                android:layout_marginBottom="16dp"/>

            <!-- Full Results Container -->
            <LinearLayout
                android:id="@+id/cardResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Main Analysis Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#EAEAEA"
                    app:cardPreventCornerOverlap="false"
                    app:cardBackgroundColor="@android:color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Top Header Row: Crop Info on Left, Health Score Gauge on Right -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="16dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginEnd="12dp">

                                <TextView
                                    android:id="@+id/tvCropName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Crop Name / फसल का नाम"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    android:textColor="#1A1A1A" />

                                <TextView
                                    android:id="@+id/tvHealthStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Health Status / स्वास्थ्य स्थिति"
                                    android:textSize="13sp"
                                    android:textColor="#596475"
                                    android:layout_marginTop="4dp" />

                                <TextView
                                    android:id="@+id/tvResponseTime"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Response in 1.2s"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="#0288D1"
                                    android:layout_marginTop="6dp" />
                            </LinearLayout>

                            <com.rcc.jai_kisan.CircularHealthScoreView
                                android:id="@+id/healthScoreView"
                                android:layout_width="82dp"
                                android:layout_height="82dp"
                                android:layout_gravity="center_vertical" />
                        </LinearLayout>

                        <!-- Survival Chance Card -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardSurvivalChance"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="#D7ECD9"
                            app:cardPreventCornerOverlap="false"
                            app:cardBackgroundColor="#F2F9F2">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <TextView
                                            android:id="@+id/tvSurvivalChanceLabelEn"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Survival Chance"
                                            android:textSize="14sp"
                                            android:textStyle="bold"
                                            android:textColor="#1A1A1A" />

                                        <TextView
                                            android:id="@+id/tvSurvivalChanceLabelHi"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="जीवित रहने की संभावना"
                                            android:textSize="13sp"
                                            android:textStyle="bold"
                                            android:textColor="#1A1A1A"
                                            android:layout_marginTop="2dp" />
                                    </LinearLayout>

                                    <TextView
                                        android:id="@+id/tvSurvivalChancePercent"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="70%"
                                        android:textSize="22sp"
                                        android:textStyle="bold"
                                        android:textColor="#2E7D32" />
                                </LinearLayout>

                                <com.google.android.material.progressindicator.LinearProgressIndicator
                                    android:id="@+id/survivalProgressIndicator"
                                    android:layout_width="match_parent"
                                    android:layout_height="6dp"
                                    android:layout_marginTop="12dp"
                                    app:trackCornerRadius="3dp"
                                    app:trackThickness="6dp"
                                    app:trackColor="#D7ECD9"
                                    app:indicatorColor="#2E7D32" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Disease Badge Card -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardDiseaseBadge"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="#FFCDD2"
                            app:cardBackgroundColor="#FFEBEE">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:padding="12dp">

                                <ImageView
                                    android:id="@+id/ivDiseaseIcon"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:layout_marginEnd="12dp"
                                    android:src="@drawable/ic_pest"
                                    android:contentDescription="Disease Icon" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tvDiseaseTitle"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Disease Name"
                                        android:textSize="15sp"
                                        android:textStyle="bold"
                                        android:textColor="#C62828" />

                                    <TextView
                                        android:id="@+id/tvScientificName"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Scientific Name"
                                        android:textSize="12sp"
                                        android:fontFamily="serif"
                                        android:textStyle="italic"
                                        android:textColor="#B71C1C"
                                        android:visibility="gone" />
                                </LinearLayout>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Summary Block -->
                        <TextView
                            android:id="@+id/tvSummaryLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Summary / सारांश"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#2E7D32"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tvSummaryEn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:lineSpacingExtra="2dp"
                            android:textColor="#333333" />

                        <TextView
                            android:id="@+id/tvSummaryHi"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:lineSpacingExtra="2dp"
                            android:textColor="#616161"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="16dp" />

                        <!-- Do's Section -->
                        <TextView
                            android:id="@+id/tvDosLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Recommended Actions / क्या करें (Do's)"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#2E7D32"
                            android:layout_marginBottom="6dp" />

                        <LinearLayout
                            android:id="@+id/layoutDosContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginBottom="16dp" />

                        <!-- Don'ts Section -->
                        <TextView
                            android:id="@+id/tvDontsLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Things to Avoid / क्या न करें (Don'ts)"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#C62828"
                            android:layout_marginBottom="6dp" />

                        <LinearLayout
                            android:id="@+id/layoutDontsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginBottom="16dp" />

                        <!-- Fertilizers & Cures Section -->
                        <TextView
                            android:id="@+id/tvCuresLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cures &amp; Fertilizers / उपचार एवं उर्वरक"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#005B96"
                            android:layout_marginBottom="6dp" />

                        <LinearLayout
                            android:id="@+id/layoutFertilizersContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginBottom="20dp" />

                        <!-- Quick Calculator Links Section -->
                        <TextView
                            android:id="@+id/tvApplyToolsLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Apply to Farming Tools / संबंधित उपकरण"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#424242"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:id="@+id/layoutCalculatorButtons"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginBottom="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="8dp">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnFertilizersCalc"
                                    style="@style/Widget.Material3.Button.TonalButton"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Fertilizer Calc\nउर्वरक कैलकुलेटर"
                                    android:textSize="12sp"
                                    android:layout_marginEnd="4dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnCostsCalc"
                                    style="@style/Widget.Material3.Button.TonalButton"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Cost Calculator\nलागत कैलकुलेटर"
                                    android:textSize="12sp"
                                    android:layout_marginStart="4dp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnIrrigationPlanner"
                                    style="@style/Widget.Material3.Button.TonalButton"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Irrigation Planner\nसिंचाई योजना"
                                    android:textSize="12sp"
                                    android:layout_marginEnd="4dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnYieldEstimator"
                                    style="@style/Widget.Material3.Button.TonalButton"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Yield Estimator\nपैदावार अनुमान"
                                    android:textSize="12sp"
                                    android:layout_marginStart="4dp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Govt Scheme Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnGovtScheme"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Govt Schemes / सरकारी योजनाएं"
                            android:layout_marginBottom="12dp"
                            app:icon="@drawable/ic_modern_search" />

                        <!-- Find Centers & Share Report Row -->
                        <LinearLayout
                            android:id="@+id/layoutFindCentersShareRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnFindCenters"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Find Centers\nकृषि केंद्र खोजें"
                                android:textSize="12sp"
                                android:layout_marginEnd="4dp"
                                app:icon="@drawable/ic_weather_location" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnShareReport"
                                style="@style/Widget.Material3.Button"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Share Report\nरिपोर्ट साझा करें"
                                android:textSize="12sp"
                                android:layout_marginStart="4dp"
                                app:backgroundTint="#2E7D32"
                                app:icon="@drawable/ic_modern_share" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

