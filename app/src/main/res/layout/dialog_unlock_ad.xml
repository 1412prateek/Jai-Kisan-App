<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_dialog"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="26dp"
    android:paddingBottom="24dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#D7CCC8"
        android:layout_marginBottom="16dp" />

    <!-- Icon Badge -->
    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_circle_gold"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="🎬"
            android:textSize="32sp" />
    </FrameLayout>

    <!-- Dialog Title -->
    <TextView
        android:id="@+id/tvUnlockDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Unlock Photo Expert / फ़ोटो विश्लेषण अनलॉक करें"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="#2E7D32"
        android:layout_marginBottom="10dp" />

    <!-- Dialog Description -->
    <TextView
        android:id="@+id/tvUnlockDialogDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Watch a short video ad to unlock 3 more Photo Expert analyses &amp; keep Jai Kisan 100% free for all farmers."
        android:textSize="13sp"
        android:textColor="#424242"
        android:lineSpacingExtra="3dp"
        android:layout_marginBottom="22dp" />

    <!-- Watch Ad CTA Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnWatchAdConfirm"
        style="@style/Widget.Material3.Button.ElevatedButton"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="▶  Watch Short Ad (+3 Credits)"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        app:backgroundTint="#2E7D32"
        app:cornerRadius="27dp"
        app:elevation="4dp"
        android:layout_marginBottom="10dp" />

    <!-- Cancel / Close Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnWatchAdCancel"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Cancel / रद्द करें"
        android:textSize="14sp"
        android:textColor="#757575" />

</LinearLayout>
