<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F9F6ED">

    <ScrollView
        android:id="@+id/aboutScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="36dp">

        <!-- Logo with subtle warm elevation -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="104dp"
            android:layout_height="104dp"
            app:cardCornerRadius="52dp"
            app:strokeWidth="2.5dp"
            app:strokeColor="#A69659"
            app:cardElevation="3dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp">
            <ImageView
                android:id="@+id/imgGrandfather"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/jai_kisan_logo_copy" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jai Kisan"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1B1B1B"
            android:layout_marginTop="2dp"/>

        <TextView
            android:id="@+id/tvAppMotto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="मेरी मिट्टी मेरे किसान"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#388E3C"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp"/>

        <!-- Card 1: About Jai Kisan -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="6dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="#EAE5D9"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_sprout"
                        app:tint="#2E7D32"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:text="About Jai Kisan"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:textColor="#1B1B1B"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="A comprehensive digital tool for farmers featuring crop disease detection, mandi market prices, weather updates and AI-powered assistance designed to support modern agriculture."
                    android:textSize="13sp"
                    android:textColor="#555555"
                    android:lineSpacingExtra="2dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 2: Developer & Studio -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="6dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="#EAE5D9"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Developer Header -->
                <TextView
                    android:text="Developer"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="#1B1B1B"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="Prateek Kumar"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#2E7D32"
                    android:layout_marginTop="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="Founder – RSVP Studios"
                    android:textSize="12sp"
                    android:textColor="#777777"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F0EDE4"
                    android:layout_marginVertical="10dp"/>

                <!-- RSVP Studios Header -->
                <TextView
                    android:text="About RSVP Studios"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="#1B1B1B"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="RSVP Studios is an independent development studio dedicated to building meaningful and practical technology solutions that improve real-world lives."
                    android:textSize="13sp"
                    android:textColor="#555555"
                    android:lineSpacingExtra="2dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 3: Connect & Support -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="6dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="#EAE5D9"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:text="Contact"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="#1B1B1B"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEmail"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="Email"
                        android:textSize="13sp"
                        app:strokeColor="#C8E6C9"
                        app:strokeWidth="1dp"
                        app:icon="@android:drawable/ic_dialog_email"
                        app:iconTint="#388E3C"
                        android:textColor="#2E7D32"
                        android:layout_marginEnd="6dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLinkedIn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="LinkedIn"
                        android:textSize="13sp"
                        app:strokeColor="#BBDEFB"
                        app:strokeWidth="1dp"
                        app:icon="@drawable/ic_linkedin"
                        app:iconTint="#0077B5"
                        android:textColor="#0077B5"
                        android:layout_marginStart="6dp"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Circular Floating Scroll Down Button (Taps to smooth scroll down and fades out) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnScrollDown"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="4dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="21dp"
            app:cardElevation="3dp"
            app:strokeWidth="1dp"
            app:strokeColor="#DDD7C6"
            app:cardBackgroundColor="#FFFFFF">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_keyboard_arrow_down_24"
                app:tint="#6D5D3B" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Dedicated In Loving Memory Memorial Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTribute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E6DFCC"
            app:cardBackgroundColor="#FAF7EE">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingVertical="18dp"
                android:paddingHorizontal="16dp">

                <TextView
                    android:id="@+id/tvTributeSectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="In Devoted Homage &amp; Dedication"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#5A4E31" />

                <TextView
                    android:id="@+id/tvTributeSectionSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dedicated to the guiding wisdom and values of our elders"
                    android:textSize="12sp"
                    android:textColor="#857753"
                    android:textAlignment="center"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="14dp" />

                <!-- Tribute Button (Maintains exact btnMemory ID and dialog invocation) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMemory"
                    style="@style/Widget.Material3.Button.ElevatedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="In Loving Memory"
                    android:textColor="#5A4A28"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_tribute_flower"
                    app:iconTint="@null"
                    app:iconSize="30dp"
                    app:iconPadding="10dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#D7CEB8"
                    app:backgroundTint="#FFFFFF"
                    android:paddingHorizontal="24dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Transparency & Community Mission Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTransparency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="#C5D3C8"
            app:cardBackgroundColor="#F1F8F3">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_about_dev"
                        app:tint="#2E7D32"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tvTransparencyTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Transparency &amp; Support / पारदर्शिता और सहायता"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#2E7D32" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTransparencyDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:text="Jai Kisan is a free community service. We display minimal ads solely to cover AI server and API costs, keeping this tool completely free for all farmers." />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRateApp"
            style="@style/Widget.Material3.Button.ElevatedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="⭐ Rate this App"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#388E3C"
            android:textColor="#FFFFFF"
            app:cardElevation="4dp"
            android:layout_marginTop="16dp"/>

        <TextView
            android:id="@+id/appVersionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Version 1.0.3"
            android:textSize="12sp"
            android:textColor="#999999"
            android:layout_marginTop="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="© 2026 RSVP Studios. All Rights Reserved."
            android:textSize="11sp"
            android:textColor="#AAAAAA"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="28dp"/>

    </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/adBannerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:background="#FAFAFA" />

</LinearLayout>