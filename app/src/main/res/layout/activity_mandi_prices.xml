<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_background"
    android:fitsSystemWindows="true"
    tools:context=".MandiPricesActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="32dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp"
            app:cardUseCompatPadding="true"
            app:cardBackgroundColor="@color/theme_sandy_brown">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                app:title="Mandi Prices / मंडी भाव"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:titleTextColor="@color/text_on_sandy_brown"
                app:navigationIcon="@drawable/ic_arrow_back_24"
                app:navigationIconTint="@color/text_on_sandy_brown" />



        </com.google.android.material.card.MaterialCardView>

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:paddingTop="8dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="10dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/theme_mint_cream">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layout_state"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="State / राज्य *"
                        app:boxStrokeColor="@color/theme_reseda_green"
                        app:hintTextColor="@color/theme_reseda_green"
                        android:layout_marginBottom="12dp">

                        <AutoCompleteTextView
                            android:id="@+id/spinnerState"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layout_city"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="District / ज़िला *"
                        app:boxStrokeColor="@color/theme_reseda_green"
                        app:hintTextColor="@color/theme_reseda_green"
                        android:layout_marginBottom="12dp">

                        <AutoCompleteTextView
                            android:id="@+id/spinnerCity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layout_crop"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxStrokeColor="@color/theme_reseda_green"
                        app:hintTextColor="@color/theme_reseda_green"
                        android:layout_marginBottom="12dp"
                        android:hint="Commodity / फसल">

                        <AutoCompleteTextView
                            android:id="@+id/spinnerCrop"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layout_variety"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxStrokeColor="@color/theme_reseda_green"
                        app:hintTextColor="@color/theme_reseda_green"
                        android:hint="Variety (Optional) / किस्म (वैकल्पिक)">

                        <AutoCompleteTextView
                            android:id="@+id/spinnerVariety"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="10dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/theme_mint_cream">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDateFrom"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="From / से"
                            app:icon="@drawable/ic_calendar"
                            android:textColor="@color/theme_black_bean"
                            app:iconTint="@color/theme_black_bean"
                            app:backgroundTint="@color/theme_celadon"
                            android:layout_marginEnd="8dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDateTo"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="To / तक"
                            app:icon="@drawable/ic_calendar"
                            android:textColor="@color/theme_black_bean"
                            app:iconTint="@color/theme_black_bean"
                            app:backgroundTint="@color/theme_celadon"
                            android:layout_marginStart="8dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layout_sort_by"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:hint="Sort By / क्रमबद्ध करें"
                            app:boxStrokeColor="@color/theme_cambridge_blue"
                            app:hintTextColor="@color/theme_cambridge_blue"
                            android:layout_marginEnd="8dp">
                            <AutoCompleteTextView
                                android:id="@+id/spinnerSortField"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layout_sort_order"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:hint="Order / क्रम"
                            app:boxStrokeColor="@color/theme_cambridge_blue"
                            app:hintTextColor="@color/theme_cambridge_blue"
                            android:layout_marginStart="8dp">
                            <AutoCompleteTextView
                                android:id="@+id/spinnerSortOrder"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_note_optional_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Note: Date selection is optional. / ध्यान दें: तारीख चुनना वैकल्पिक है।"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="?android:attr/textColorSecondary"
                        android:gravity="center_horizontal"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReset"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reset / रीसेट"
                    app:icon="@drawable/ic_restart_alt"
                    android:textColor="@color/theme_paynes_gray"
                    app:strokeColor="@color/theme_paynes_gray"
                    app:iconTint="@color/theme_paynes_gray"
                    android:layout_marginEnd="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGetPrices"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Preview / पूर्वावलोकन"
                    app:backgroundTint="#294FF6"
                    app:icon="@drawable/ic_modern_search"/>
            </LinearLayout>

            <com.google.android.material.loadingindicator.LoadingIndicator
                android:id="@+id/loadingIndicator"
                style="@style/Widget.Material3.LoadingIndicator.Contained"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="16dp"/>


            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Modal Price & Trend Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_title_modal_price"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Modal Price / सामान्य मूल्य"
                                android:textColor="#1B5E20"
                                android:textStyle="bold"
                                android:textSize="12sp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="bottom"
                                android:layout_marginTop="2dp">

                                <TextView
                                    android:id="@+id/tvUiModalPrice"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="--"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    android:textColor="#212121" />

                                <TextView
                                    android:id="@+id/tvUiModalPriceSuffix"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=" / Q"
                                    android:textSize="12sp"
                                    android:textColor="#757575"
                                    android:layout_marginStart="4dp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="bottom"
                                android:layout_marginTop="2dp">

                                <TextView
                                    android:id="@+id/tvUiModalPriceKg"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="--"
                                    android:textSize="13sp"
                                    android:textColor="#558B2F"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvUiModalPriceKgSuffix"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=" / kg"
                                    android:textSize="11sp"
                                    android:textColor="#757575"
                                    android:layout_marginStart="2dp" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="end">

                            <TextView
                                android:id="@+id/tv_title_market_trend"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Market Trend / बाज़ार रुख"
                                android:textColor="#1B5E20"
                                android:textStyle="bold"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvUiTrend"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#E65100"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Price Range -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="#F5F5F5"
                        android:padding="8dp"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:id="@+id/tv_title_price_range"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Estimated Price Range / मूल्य सीमा: "
                            android:textSize="11sp"
                            android:textColor="#757575" />

                        <TextView
                            android:id="@+id/tvUiPriceRange"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#212121" />

                        <TextView
                            android:id="@+id/tvUiPriceRangeSuffix"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" / Q"
                            android:textSize="11sp"
                            android:textColor="#757575"
                            android:layout_marginStart="2dp" />
                    </LinearLayout>

                    <!-- 7-Day Trend Chart -->
                    <TextView
                        android:id="@+id/tv_title_7day_trend"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="7-Day Price Trend / 7-दिनों का मूल्य रुझान"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#1B5E20"
                        android:layout_marginBottom="4dp" />

                    <com.rcc.jai_kisan.PriceTrendChartView
                        android:id="@+id/priceTrendChartView"
                        android:layout_width="match_parent"
                        android:layout_height="130dp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tvUiTrendDescEn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="#424242" />

                    <TextView
                        android:id="@+id/tvUiTrendDescHi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="#616161"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="12dp" />

                    <!-- Weather Impact Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#FFF3E0"
                        android:padding="10dp"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:id="@+id/tv_title_weather_impact"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚠ Weather Impact / मौसम का प्रभाव"
                            android:textStyle="bold"
                            android:textSize="11sp"
                            android:textColor="#E65100" />

                        <TextView
                            android:id="@+id/tvUiWeatherImpactEn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textSize="12sp"
                            android:textColor="#5D4037" />

                        <TextView
                            android:id="@+id/tvUiWeatherImpactHi"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textSize="12sp"
                            android:textColor="#6D4C41" />

                        <TextView
                            android:id="@+id/tvUiWeatherImpact"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Farmer Advisory Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#E8F5E9"
                        android:padding="10dp"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:id="@+id/tv_title_farmer_advisory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💡 Farmer Advisory / किसान सलाह"
                            android:textStyle="bold"
                            android:textSize="11sp"
                            android:textColor="#2E7D32" />

                        <TextView
                            android:id="@+id/tvUiFarmerAdviceEn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textSize="12sp"
                            android:textColor="#1B5E20" />

                        <TextView
                            android:id="@+id/tvUiFarmerAdviceHi"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textSize="12sp"
                            android:textColor="#2E7D32" />

                        <TextView
                            android:id="@+id/tvUiFarmerAdvice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Raw Response / Description fallback -->
                    <TextView
                        android:id="@+id/tvUiDescriptionEn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="#424242"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvUiDescriptionHi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="#616161"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvPriceResults"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <!-- Share Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSharePdf"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Share Report / रिपोर्ट साझा करें"
                        app:icon="@drawable/ic_modern_share"
                        app:backgroundTint="#2E7D32" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#15000000"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Title -->
                    <TextView
                        android:id="@+id/tv_title_disclaimer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⚠ Disclaimer / अस्वीकरण"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:textColor="#000000"
                        android:layout_marginBottom="6dp"/>

                    <!-- English -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="#444444"
                        android:lineSpacingExtra="2dp"
                        android:justificationMode="inter_word"
                        android:text="This report is generated using AI-based analysis and estimated market patterns. Actual mandi prices may vary depending on location and market conditions."
                        android:layout_marginBottom="6dp"/>

                    <!-- Hindi / Regional -->
                    <TextView
                        android:id="@+id/tv_disclaimer_hi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="#444444"
                        android:lineSpacingExtra="2dp"
                        android:justificationMode="inter_word"
                        android:text="यह रिपोर्ट AI आधारित विश्लेषण और अनुमानित बाजार प्रवृत्तियों पर आधारित है। वास्तविक मंडी कीमतें स्थान और बाजार की स्थिति के अनुसार भिन्न हो सकती हैं।"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>


</LinearLayout>