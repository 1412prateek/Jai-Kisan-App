<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_background"
    android:fitsSystemWindows="true"
    tools:context=".HowToUseActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/theme_celadon">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="How to Use / कैसे इस्तेमाल करे"
            app:titleTextColor="@color/theme_black_bean"
            app:navigationIconTint="@color/theme_black_bean" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/theme_mint_cream"
                app:cardCornerRadius="16dp"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1. Photo Expert / फोटो विशेषज्ञ"
                        android:textColor="@color/theme_black_bean"
                        android:textStyle="bold"
                        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/theme_caput_mortuum"
                        android:text="- Tap 'Capture' or 'Upload' to select an image.\n- Press 'Analyze Photo' to get a detailed report.\n- Use the 'Share' button to send the report to others.\n\n- छवि चुनने के लिए 'फोटो लें' या 'अपलोड करें' पर टैप करें।\n- विस्तृत रिपोर्ट पाने के लिए 'फोटो का विश्लेषण करें' दबाएं।\n- रिपोर्ट दूसरों को भेजने के लिए 'साझा करें' बटन का उपयोग करें।" />
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/howto_detect"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/theme_mint_cream"
                app:cardCornerRadius="16dp"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2. Mandi Prices / मंडी भाव"
                        android:textColor="@color/theme_black_bean"
                        android:textStyle="bold"
                        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/theme_caput_mortuum"
                        android:text="- Select your State, District, and Crop.\n- Choose a date range and sorting order.\n- Tap 'Preview' to see the latest prices.\n\n- अपना राज्य, जिला और फसल चुनें।\n- तारीख सीमा और क्रम चुनें।\n- नवीनतम मूल्य देखने के लिए 'पूर्वावलोकन' पर टैप करें।" />
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/howto_mandi"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/theme_mint_cream"
                app:cardCornerRadius="16dp"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3. Weather Info / मौसम जानकारी"
                        android:textColor="@color/theme_black_bean"
                        android:textStyle="bold"
                        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/theme_caput_mortuum"
                        android:text="- Automatically detects your location.\n- Shows current temperature and conditions.\n- Provides a 5-day forecast.\n\n- यह स्वचालित रूप से आपके स्थान का पता लगाता है।\n- वर्तमान तापमान और स्थिति दिखाता है।\n- 5-दिन का पूर्वानुमान प्रदान करता है।" />
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/howto_weather"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/theme_mint_cream"
                app:cardCornerRadius="16dp"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4. Voice Assistant / आवाज़ सहायक"
                        android:textColor="@color/theme_black_bean"
                        android:textStyle="bold"
                        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/theme_caput_mortuum"
                        android:text="- Tap the Microphone icon and ask your question.\n- Speak clearly in your preferred language.\n- Get instant solutions and listen to them via audio.\n\n- माइक्रोफोन आइकन पर टैप करें और अपना प्रश्न पूछें।\n- अपनी पसंदीदा भाषा में स्पष्ट रूप से बोलें।\n- त्वरित समाधान प्राप्त करें और उन्हें ऑडियो के माध्यम से सुनें।" />
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="250dp"
                        android:layout_marginTop="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/howto_voice"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/theme_mint_cream"
                app:cardCornerRadius="16dp"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5. Farming Tools / खेती उपकरण"
                        android:textColor="@color/theme_black_bean"
                        android:textStyle="bold"
                        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/theme_caput_mortuum"
                        android:text="- Access specialized calculators for your farm.\n- Calculate fertilizers, yield, and irrigation needs.\n- Manage costs efficiently with the cost calculator.\n\n- अपने खेत के लिए विशेष कैलकुलेटर तक पहुंचें।\n- उर्वरक, उपज और सिंचाई की आवश्यकताओं की गणना करें।\n- लागत कैलकुलेटर के साथ लागत का कुशलतापूर्वक प्रबंधन करें।" />
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="250dp"
                        android:layout_marginTop="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/howto_tools"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>